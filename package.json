{
  "name": "tavern-roamer",
  "version": "0.1.1",
  "description": "SillyTavern Google Drive chat roaming helper for Tavern Helper / JS-Slash-Runner.",
  "type": "module",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ],
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
