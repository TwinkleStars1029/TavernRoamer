{
  "name": "tavern-roamer",
  "version": "0.1.2",
  "description": "SillyTavern Google Drive chat roaming helper for Tavern Helper / JS-Slash-Runner.",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.13.0 || >=24 <25"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:dependencies": "pnpm audit --audit-level low",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "webpack": "^5.112.0",
    "webpack-cli": "^6.0.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.12",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.8",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "source-map-js": "1.2.2",
      "vite": "7.3.7"
    }
  }
}
